# Copy to config/vault_taxonomy.local.yaml (git-ignored) and edit.
# Merged over vault_taxonomy.yaml at load: entries are added, or replace
# same-keyed entries (topics are keyed by name); `remove` deletes by value.
doc_types:
  - field_report
domains:
  - hobbies
topics:
  - name: hobbies/gardening
    description: Garden layouts, planting schedules, and plant care.
  - name: work/hiring
    description: Sourcing and interviewing candidates for the example team.
# Tag -> topic and `type:` -> document type entries add or replace by key. A
# committed mapping whose topic this file removes is dropped (with a warning);
# repoint it here, e.g. `1-1: work/one_on_ones` with that topic declared above.
tag_topics:
  gardening: hobbies/gardening
type_doc_types:
  fieldnote: field_report
remove:
  topics:
    - mixed/inbox
  tag_topics:
    - ideas
project_sources:
  - work_subfolders
