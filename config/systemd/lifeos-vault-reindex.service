[Unit]
Description=LifeOS incremental vault reindex
After=lifeos-api.service lifeos-chromadb.service

[Service]
Type=oneshot
User=__USER__
WorkingDirectory=__LIFEOS_DIR__
ExecStart=__LIFEOS_DIR__/scripts/vault_reindex_timer.sh
Nice=10
TimeoutStartSec=14400
StandardOutput=append:__LIFEOS_DIR__/logs/vault-reindex.log
StandardError=append:__LIFEOS_DIR__/logs/vault-reindex.log
