[Unit]
Description=LifeOS Local LLM (llama-server)
After=network.target
Before=lifeos-api.service

[Service]
Type=simple
User=__USER__
WorkingDirectory=__LLAMA_CPP_DIR__
Environment=ROCBLAS_USE_HIPBLASLT=1
ExecStart=__LLAMA_CPP_DIR__/build/bin/llama-server \
    -hf __LLM_MODEL__ \
    -ngl 99 \
    -fa on \
    --jinja \
    --no-mmap \
    -c 32768 \
    --host 0.0.0.0 \
    --port 8080
Restart=on-failure
RestartSec=10
StandardOutput=append:__LIFEOS_DIR__/logs/llama-server.log
StandardError=append:__LIFEOS_DIR__/logs/llama-server.log

[Install]
WantedBy=multi-user.target
