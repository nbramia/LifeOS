[Unit]
Description=LifeOS Local LLM (llama-server)
After=network.target
Before=lifeos-api.service

[Service]
Type=simple
User=__USER__
WorkingDirectory=__LLAMA_CPP_DIR__
Environment=ROCBLAS_USE_HIPBLASLT=1
ExecStart=__LLAMA_CPP_DIR__/build/bin/llama-server \
    __LLM_SOURCE_ARGS__ \
    -ngl 99 \
    -fa on \
    --jinja \
    --no-mmap \
    -c __LLM_CONTEXT_SIZE__ \
    --cache-ram __LLM_CACHE_RAM_MIB__ \
    --ctx-checkpoints __LLM_CTX_CHECKPOINTS__ \
    --host 0.0.0.0 \
    --port 8080
Restart=__LLM_RESTART_POLICY__
RestartSec=10
# Below the API and ChromaDB (-500), so a whole-machine OOM takes the
# model server, which reloads with nothing lost, before either of them.
OOMScoreAdjust=-200
StandardOutput=append:__LIFEOS_DIR__/logs/llama-server.log
StandardError=append:__LIFEOS_DIR__/logs/llama-server.log

[Install]
WantedBy=multi-user.target
