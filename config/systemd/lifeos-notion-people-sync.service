[Unit]
Description=LifeOS Notion People Sync (Email, Phone, Last Check-In)
After=lifeos-api.service

[Service]
Type=oneshot
User=__USER__
WorkingDirectory=__LIFEOS_DIR__
ExecStart=__LIFEOS_DIR__/scripts/notion_people_sync_nightly.sh
TimeoutStartSec=1800
StandardOutput=append:__LIFEOS_DIR__/logs/notion-people-sync.log
StandardError=append:__LIFEOS_DIR__/logs/notion-people-sync.log
