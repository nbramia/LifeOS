[Unit]
Description=LifeOS vault index job — indexes changed notes, ordinary notes first and each newest first, without LLM summaries
After=network.target lifeos-chromadb.service

[Service]
Type=oneshot
User=__USER__
WorkingDirectory=__LIFEOS_DIR__
EnvironmentFile=__LIFEOS_DIR__/.env
Environment=LIFEOS_HEADLESS=true
ExecStart=__VENV__/bin/python __LIFEOS_DIR__/scripts/vault_index_job.py --execute
# Shorter than the nightly reindex's wait for the vault index lock
# (LIFEOS_VAULT_INDEX_LOCK_WAIT_SECONDS), so a stuck run is killed, and its lock
# released, before that wait runs out. The job ends itself after
# LIFEOS_VAULT_INDEX_TIME_BUDGET_SECONDS, well below this. Progress is saved as it goes.
TimeoutStartSec=1200
# The same containment as lifeos-sync.service: a runaway embedding run dies
# inside its own cgroup rather than freezing the host.
MemoryHigh=60%
MemoryMax=75%
MemorySwapMax=2G
StandardOutput=append:__LIFEOS_DIR__/logs/vault-index.log
StandardError=append:__LIFEOS_DIR__/logs/vault-index.log
