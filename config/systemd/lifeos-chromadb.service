[Unit]
Description=LifeOS ChromaDB Vector Database
After=network.target

[Service]
Type=simple
User=nathanramia
WorkingDirectory=/home/nathanramia/Documents/Code/LifeOS
ExecStart=/home/nathanramia/.venvs/lifeos/bin/chroma run --host localhost --port 8001 --path /home/nathanramia/Documents/Code/LifeOS/data/chromadb
Restart=on-failure
RestartSec=5
StandardOutput=append:/home/nathanramia/Documents/Code/LifeOS/logs/chromadb.log
StandardError=append:/home/nathanramia/Documents/Code/LifeOS/logs/chromadb.log

[Install]
WantedBy=multi-user.target
