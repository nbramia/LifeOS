[Unit]
Description=LifeOS Nightly Data Sync
After=network.target lifeos-api.service

[Service]
Type=oneshot
User=__USER__
WorkingDirectory=__LIFEOS_DIR__
EnvironmentFile=__LIFEOS_DIR__/.env
Environment=LIFEOS_HEADLESS=true
ExecStart=__LIFEOS_DIR__/scripts/run_sync_wrapper.sh --execute --trigger scheduled
TimeoutStartSec=21600
StandardOutput=append:__LIFEOS_DIR__/logs/sync.log
StandardError=append:__LIFEOS_DIR__/logs/sync.log
