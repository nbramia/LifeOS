[Unit]
Description=LifeOS FastAPI Server
After=network.target lifeos-chromadb.service ollama.service
Wants=lifeos-chromadb.service

[Service]
Type=simple
User=nathanramia
WorkingDirectory=/home/nathanramia/Documents/Code/LifeOS
EnvironmentFile=/home/nathanramia/Documents/Code/LifeOS/.env
Environment=HSA_OVERRIDE_GFX_VERSION=11.0.0
ExecStart=/home/nathanramia/Documents/Code/LifeOS/scripts/server.sh foreground
Restart=on-failure
RestartSec=5
StandardOutput=append:/home/nathanramia/Documents/Code/LifeOS/logs/server.log
StandardError=append:/home/nathanramia/Documents/Code/LifeOS/logs/server.log

[Install]
WantedBy=multi-user.target
