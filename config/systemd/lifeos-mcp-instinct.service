[Unit]
Description=LifeOS MCP HTTP Transport (Instinct)
After=network.target lifeos-api.service
Wants=lifeos-api.service

[Service]
Type=simple
User=__USER__
WorkingDirectory=__LIFEOS_DIR__
EnvironmentFile=__LIFEOS_DIR__/.env
ExecStart=__VENV__/bin/python __LIFEOS_DIR__/mcp_server.py --transport http --port 8766 --instance instinct
Restart=on-failure
RestartSec=10
StandardOutput=append:__LIFEOS_DIR__/logs/mcp-instinct.log
StandardError=append:__LIFEOS_DIR__/logs/mcp-instinct.log

[Install]
WantedBy=multi-user.target
