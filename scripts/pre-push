#!/bin/bash
#
# LifeOS Pre-push Hook
#
# Runs unit tests before allowing pushes. Output is redirected to a log
# file to avoid flooding the terminal — only a pass/fail summary is shown.
#
# Installation: none. This repo sets `core.hooksPath = scripts`, so git runs
# THIS tracked file directly. Do not copy it into .git/hooks — a copy there is
# never executed, and a stale one is actively misleading (one sat in
# .git/hooks/pre-push from 2026-07-09 until it was removed).
#

set -e

PROJECT_ROOT="$(git rev-parse --show-toplevel)"
cd "$PROJECT_ROOT"

# git exports GIT_DIR (absolute when pushing from a worktree) while running
# hooks. Test subprocesses that spawn `git` in fixture repos inherit it and
# operate on THIS repo instead — committing fixture files onto real branches,
# flipping core.bare, and rewriting user identity. Scrub the family so every
# git call below (and inside pytest) resolves via cwd.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_COMMON_DIR

# Detect what's being pushed so we can skip tests on docs-only pushes.
# git feeds pre-push hooks lines of "local_ref local_sha remote_ref remote_sha" on stdin.
CHANGED_FILES=""
ZERO_SHA="0000000000000000000000000000000000000000"
# Did any ref in this push actually carry commits? A deletion-only push has
# nothing to test, but it also yields an empty CHANGED_FILES — which the
# classifier below (correctly) treats as "unknown, run everything". Tracking
# this separately is what lets a pure deletion exit early instead of running
# the whole suite just to delete a branch.
HAVE_CONTENT=0
# First local_ref seen on stdin — used below to derive a per-branch log path.
PUSH_LOCAL_REF=""
while read local_ref local_sha remote_ref remote_sha; do
    [ -z "$local_sha" ] && continue
    # Deletion push (local_sha is zeros) — nothing to diff.
    [ "$local_sha" = "$ZERO_SHA" ] && continue
    HAVE_CONTENT=1
    [ -z "$PUSH_LOCAL_REF" ] && PUSH_LOCAL_REF="$local_ref"
    if [ "$remote_sha" = "$ZERO_SHA" ]; then
        # New branch: diff against origin/main if available, else last 10 commits.
        MERGE_BASE=$(git merge-base "$local_sha" origin/main 2>/dev/null || echo "${local_sha}~10")
        DIFF=$(git diff --name-only "$MERGE_BASE" "$local_sha" 2>/dev/null || true)
    else
        DIFF=$(git diff --name-only "$remote_sha" "$local_sha" 2>/dev/null || true)
    fi
    CHANGED_FILES="$CHANGED_FILES"$'\n'"$DIFF"
done
CHANGED_FILES=$(echo "$CHANGED_FILES" | sort -u | grep -v '^$' || true)

# --- Per-run log paths (#908) --------------------------------------------
# Fixed /tmp paths used to be shared across every worktree/branch/agent on
# this machine, so concurrent pushes clobbered each other's output and a
# result could be misattributed to the wrong branch. Derive a per-branch,
# per-process path instead: reproducible from the branch (no guessing to
# find a failure's log) and unique per concurrent run (no collision).
LOG_DIR="${TMPDIR:-/tmp}/lifeos-prepush"
mkdir -p -m 700 "$LOG_DIR" 2>/dev/null || true
# Prune logs older than 3 days so this directory doesn't grow unbounded.
# Never touch anything younger than that — a live run's log, passing or
# failing, must survive until someone reads it.
find "$LOG_DIR" -maxdepth 1 -type f -mtime +3 -delete 2>/dev/null || true

sanitize_branch_slug() {
    # Replace everything outside [A-Za-z0-9._-] (slashes included) with "_",
    # so a branch like "feat/x" or a hostile "../../etc/passwd" collapses to
    # a single safe filename component that can't escape LOG_DIR. Cap the
    # length so a very long branch name can't produce an unwieldy path.
    local slug
    slug=$(printf '%s' "$1" | tr -c 'A-Za-z0-9._-' '_')
    slug="${slug:0:80}"
    [ -z "$slug" ] && slug="unknown"
    printf '%s' "$slug"
}

if [ -n "$PUSH_LOCAL_REF" ] && [[ "$PUSH_LOCAL_REF" == refs/heads/* ]]; then
    BRANCH_RAW="${PUSH_LOCAL_REF#refs/heads/}"
else
    # No branch ref on stdin (e.g. a tag push, or nothing read at all) —
    # fall back to the checked-out branch, then a literal placeholder.
    BRANCH_RAW=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "unknown")
    [ "$BRANCH_RAW" = "HEAD" ] && BRANCH_RAW="detached"
fi
BRANCH_SLUG=$(sanitize_branch_slug "$BRANCH_RAW")

LOG="$LOG_DIR/${BRANCH_SLUG}-$$-unit.log"
BROWSER_LOG="$LOG_DIR/${BRANCH_SLUG}-$$-browser.log"

# Test overrides: stand in for the stdin ref lines so the decision below can be
# exercised without a real push (mirrors test.sh's LIFEOS_TEST_CHANGED_FILES).
if [ -n "${LIFEOS_PREPUSH_CHANGED_FILES+x}" ]; then
    CHANGED_FILES=$(printf '%s\n' "$LIFEOS_PREPUSH_CHANGED_FILES" | grep -v '^$' || true)
    HAVE_CONTENT="${LIFEOS_PREPUSH_HAVE_CONTENT:-1}"
fi

# Emit the decision and stop, without running anything.
plan_only_exit() {
    if [ -n "${LIFEOS_PREPUSH_PLAN_ONLY:-}" ]; then
        echo "prepush-plan: $1"
        echo "prepush-log: $LOG"
        echo "prepush-browser-log: $BROWSER_LOG"
        exit 0
    fi
}

# Is this push docs-only? Delegate to test.sh's decide_plan rather than keeping
# a second copy of the classification here. The two had already drifted: this
# hook's own regex matched `\.txt$`, so a requirements.txt / constraints.txt
# bump counted as "docs" and skipped the entire suite, while decide_plan
# deliberately excludes dependency manifests ("a dep bump must still run tests
# rather than skipping"). One implementation, covered by tests/test_test_sh_auto.py
# and tests/test_prepush_gate.py.
docs_only() {
    [ -n "$CHANGED_FILES" ] || return 1
    [ -f "$PROJECT_ROOT/scripts/test.sh" ] || return 1
    local plan
    plan=$(LIFEOS_TEST_PLAN_ONLY=1 LIFEOS_TEST_CHANGED_FILES="$CHANGED_FILES" \
        bash "$PROJECT_ROOT/scripts/test.sh" auto 2>/dev/null \
        | sed -n 's/^auto-plan: //p')
    [ "$plan" = "skip" ]
}

# Deletion-only push: no commits are being sent, so there is nothing to gate.
if [ "$HAVE_CONTENT" = "0" ]; then
    plan_only_exit "skip-deletion"
    echo "Pre-push: ref deletion only, nothing to test"
    exit 0
fi

if docs_only; then
    plan_only_exit "skip-docs"
    echo "Pre-push: docs-only push, skipping tests"
    exit 0
fi

plan_only_exit "run"

# Activate virtual environment
if [ -f "$HOME/.venvs/lifeos/bin/activate" ]; then
    source "$HOME/.venvs/lifeos/bin/activate"
fi

fail() {
    echo "FAILED ($(tail -1 "$LOG"))"
    echo "  Full output: $LOG"
    exit 1
}

echo "Log: $LOG"
echo -n "Running unit tests... "

# #682: this scope (`-m "unit and not slow"`) and scripts/test.sh's unit
# scope (the negative filter over browser/requires_server/integration/slow)
# are meant to agree, and after the #682 marker triage they collect the
# identical set (verified via --collect-only on both filters). Getting there
# required removing a conftest.py auto-marker that used to tag any test whose
# *name* contained "real_" or "integration" with `integration` on top of
# whatever marker it already carried — see tests/conftest.py's
# pytest_collection_modifyitems for the full story.
#
# Parallelize across all cores via pytest-xdist (-n auto). --ff runs
# previously-failed tests first, so a repeat failure surfaces in seconds
# without narrowing what actually runs.
#
# Deliberately no last-failed-only flag. Restricting the run to previously
# failed tests whenever a lastfailed cache existed collapsed the gate: fail
# once, fix it, and the next push ran a handful of tests out of ~2400 and
# passed — at exactly the moment the code had just changed. --ff keeps the
# fast-feedback ordering; it just doesn't deselect anything.
python -m pytest -m "unit and not slow" tests/ -q --tb=line --no-header \
    -n auto --ff > "$LOG" 2>&1 || fail
echo "passed ($(tail -1 "$LOG"))"

# Browser tests that need no running server. Server-dependent ones carry
# `requires_server`; including those would tie every push to the health of a
# shared lifeos-api that other agents bounce constantly. The rest serve web/
# themselves and stub every /api/ call, and are the only gate that catches a
# regression in the chat SPA's JS before it reaches main.
#
# Deliberately a second pytest process, not another marker in the run above:
# pytest-playwright's sync API leaves its own event loop current, so any async
# test that lands after a browser test in the same process is silently never
# awaited. Under `-n auto` that ordering is nondeterministic.
#
# -p no:cacheprovider keeps this run out of .pytest_cache so it can't disturb
# the unit run's --ff ordering data.
if python -c "import playwright" 2>/dev/null; then
    # Its own log, so a browser failure doesn't clobber the unit-run output
    # someone may still need to read.
    LOG="$BROWSER_LOG"
    echo "Log: $LOG"
    echo -n "Running server-free browser tests... "
    python -m pytest -m "browser and not requires_server" tests/ -q --tb=line \
        --no-header -p no:cacheprovider > "$LOG" 2>&1 || fail
    echo "passed ($(tail -1 "$LOG"))"
else
    # Say so rather than silently degrading — on a machine without Playwright
    # this gate is simply absent, and that should be visible.
    echo "Skipping browser tests (playwright not installed)"
fi

exit 0
