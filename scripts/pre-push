#!/bin/bash
#
# LifeOS Pre-push Hook
#
# Runs unit tests before allowing pushes. Output is redirected to a log
# file to avoid flooding the terminal — only a pass/fail summary is shown.
#
# Installation: none. This repo sets `core.hooksPath = scripts`, so git runs
# THIS tracked file directly. Do not copy it into .git/hooks — a copy there is
# never executed, and a stale one is actively misleading (one sat in
# .git/hooks/pre-push from 2026-07-09 until it was removed).
#

set -e

PROJECT_ROOT="$(git rev-parse --show-toplevel)"
cd "$PROJECT_ROOT"

# git exports GIT_DIR (absolute when pushing from a worktree) while running
# hooks. Test subprocesses that spawn `git` in fixture repos inherit it and
# operate on THIS repo instead — committing fixture files onto real branches,
# flipping core.bare, and rewriting user identity. Scrub the family so every
# git call below (and inside pytest) resolves via cwd.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_COMMON_DIR

# git invokes pre-push as `pre-push <remote name> <remote url>`. An SSH push
# URL holds a connection open for this whole gate (~9 min), and GitHub closes
# an idle SSH session after ~6 min -- so a push over SSH can fail with
# "Connection closed by remote host" even after every test passed (#886).
# Warn once with the HTTPS equivalent and keep going; never fail the push
# over this. `./scripts/setup-hooks.sh` configures the HTTPS push URL so this
# should not normally fire.
REMOTE_PUSH_URL="${2:-}"
case "$REMOTE_PUSH_URL" in
    git@*:*)
        _rest="${REMOTE_PUSH_URL#git@}"
        _host="${_rest%%:*}"
        _path="${_rest#*:}"
        echo "Warning: pushing over SSH ($REMOTE_PUSH_URL) can outlive GitHub's ~6-minute idle limit during this gate. Prefer: https://${_host}/${_path}"
        unset _rest _host _path
        ;;
    ssh://*)
        _rest="${REMOTE_PUSH_URL#ssh://}"
        _rest="${_rest#*@}"
        echo "Warning: pushing over SSH ($REMOTE_PUSH_URL) can outlive GitHub's ~6-minute idle limit during this gate. Prefer: https://${_rest}"
        unset _rest
        ;;
esac

# Detect what's being pushed so we can skip tests on docs-only pushes.
# git feeds pre-push hooks lines of "local_ref local_sha remote_ref remote_sha" on stdin.
CHANGED_FILES=""
ZERO_SHA="0000000000000000000000000000000000000000"
# Did any ref in this push actually carry commits? A deletion-only push has
# nothing to test, but it also yields an empty CHANGED_FILES — which the
# classifier below (correctly) treats as "unknown, run everything". Tracking
# this separately is what lets a pure deletion exit early instead of running
# the whole suite just to delete a branch.
HAVE_CONTENT=0
# First local_ref seen on stdin — used below to derive a per-branch log path.
PUSH_LOCAL_REF=""
while read local_ref local_sha remote_ref remote_sha; do
    [ -z "$local_sha" ] && continue
    # Deletion push (local_sha is zeros) — nothing to diff.
    [ "$local_sha" = "$ZERO_SHA" ] && continue
    HAVE_CONTENT=1
    [ -z "$PUSH_LOCAL_REF" ] && PUSH_LOCAL_REF="$local_ref"
    if [ "$remote_sha" = "$ZERO_SHA" ]; then
        # New branch: diff against origin/main if available, else last 10 commits.
        MERGE_BASE=$(git merge-base "$local_sha" origin/main 2>/dev/null || echo "${local_sha}~10")
        DIFF=$(git diff --name-only "$MERGE_BASE" "$local_sha" 2>/dev/null || true)
    else
        DIFF=$(git diff --name-only "$remote_sha" "$local_sha" 2>/dev/null || true)
    fi
    CHANGED_FILES="$CHANGED_FILES"$'\n'"$DIFF"
done
CHANGED_FILES=$(echo "$CHANGED_FILES" | sort -u | grep -v '^$' || true)

# --- Per-run log paths (#908) --------------------------------------------
# Fixed /tmp paths used to be shared across every worktree/branch/agent on
# this machine, so concurrent pushes clobbered each other's output and a
# result could be misattributed to the wrong branch. Derive a per-branch,
# per-process path instead: reproducible from the branch (no guessing to
# find a failure's log) and unique per concurrent run (no collision).
#
# An unwritable/occupied configured directory must never block a push (a
# regression an earlier version of this hook had: a silenced `mkdir`
# failure left `$LOG` pointing nowhere, `> "$LOG"` then failed under `set -e`,
# and the push died reporting a fake test failure). So: try the configured
# directory, then a fixed fallback, then a throwaway one — and say so.
#
# Only WRITING a log to whichever directory we land on is unconditional.
# TIGHTENING (chmod) or PRUNING (find -delete) that directory is gated on
# LOG_DIR_OWNED — set only when this hook itself created/manages the
# directory it ends up using (the configured rung, the fixed-fallback rung,
# or a throwaway `mktemp -d` directory). A directory the hook merely adopted
# as a last resort (nothing left to try) is never chmod'd or swept: on a
# multi-user or containerised box that directory can be the shared system
# temp dir, and a symlinked $LOG_DIR is never trusted either — `chmod`
# follows symlinks, so a planted one would retarget the tightening onto
# whatever it points at.
# Usability (may we WRITE here, and should we stop looking further) is
# judged only by "-d && -w" — a symlink included, since writing there is
# still fine. Ownership (may we CHMOD/PRUNE here) is judged separately,
# after LOG_DIR is finalized below: a symlink is never owned regardless of
# which rung produced it, so it never falls through to a further rung on
# symlink grounds alone — that would risk skipping straight past a usable
# configured directory onto the shared fixed-fallback path.
_prepush_dir_usable() {
    [ -d "$1" ] && [ -w "$1" ]
}

_prepush_unusable_reason() {
    if [ -L "$1" ]; then
        echo "is a symlink"
    elif [ -e "$1" ] && [ ! -d "$1" ]; then
        echo "not a directory"
    elif [ -d "$1" ] && [ ! -w "$1" ]; then
        echo "not writable"
    else
        echo "could not be created"
    fi
}

LOG_DIR="${TMPDIR:-/tmp}/lifeos-prepush"
# Owned by default: everything below except the bare last-resort "/tmp" is a
# directory this hook created/manages. Forced to 0 below if $LOG_DIR turns
# out to be a symlink, regardless of which rung produced it.
LOG_DIR_OWNED=1
# -m 700 closes the window between creation and the unconditional chmod
# below; they're complementary, not alternatives — -m only sets the mode
# at creation, so it does nothing for a directory that already existed.
mkdir -p -m 700 "$LOG_DIR" 2>/dev/null || true
if ! _prepush_dir_usable "$LOG_DIR"; then
    UNUSABLE_LOG_DIR="$LOG_DIR"
    REASON=$(_prepush_unusable_reason "$LOG_DIR")
    # LIFEOS_PREPUSH_TEST_FALLBACK_DIR lets tests exercise this fallback
    # without ever touching the real, shared /tmp/lifeos-prepush. Unset in
    # production, where the fallback is always the well-known fixed path.
    FALLBACK_DIR="${LIFEOS_PREPUSH_TEST_FALLBACK_DIR:-/tmp/lifeos-prepush}"
    FALLBACK_USABLE=0
    if [ "$FALLBACK_DIR" = "$UNUSABLE_LOG_DIR" ]; then
        # The fixed fallback IS the directory just found unusable (the
        # common case: TMPDIR unset, so both resolve to /tmp/lifeos-prepush).
        # Retrying an unchanged path would fail identically — skip straight
        # to the throwaway mktemp rung instead of a pointless retry.
        FALLBACK_NOTE=" (same directory; not retried)"
    else
        mkdir -p -m 700 "$FALLBACK_DIR" 2>/dev/null || true
        if _prepush_dir_usable "$FALLBACK_DIR"; then
            FALLBACK_USABLE=1
        else
            FALLBACK_NOTE=" ($(_prepush_unusable_reason "$FALLBACK_DIR"))"
        fi
    fi

    if [ "$FALLBACK_USABLE" = "1" ]; then
        LOG_DIR="$FALLBACK_DIR"
        echo "Pre-push: log directory $UNUSABLE_LOG_DIR is unusable ($REASON); using $LOG_DIR instead"
    else
        LOG_DIR=$(mktemp -d "${TMPDIR:-/tmp}/lifeos-prepush.XXXXXX" 2>/dev/null \
            || mktemp -d 2>/dev/null || echo "")
        if [ -n "$LOG_DIR" ]; then
            echo "Pre-push: log directory $UNUSABLE_LOG_DIR is unusable ($REASON); the fixed fallback ($FALLBACK_DIR)${FALLBACK_NOTE} also failed; using $LOG_DIR instead"
        else
            # Nothing left to try. Use the shared system temp dir to write a
            # log (never block the push) but never own/tighten/sweep it.
            LOG_DIR="/tmp"
            LOG_DIR_OWNED=0
            echo "Pre-push: log directory $UNUSABLE_LOG_DIR is unusable ($REASON); every fallback failed; using $LOG_DIR instead (not owned by this hook, so it won't be chmod'd or pruned)"
        fi
    fi
fi

# A symlinked LOG_DIR is never owned, whichever rung produced it: chmod
# follows symlinks, so tightening one would retarget onto whatever it
# actually points at rather than a directory this hook manages. This can
# fire even when $LOG_DIR was otherwise "usable" (no prior message printed
# above), so say so here rather than silently degrading.
if [ -L "$LOG_DIR" ]; then
    LOG_DIR_OWNED=0
    echo "Pre-push: log directory $LOG_DIR is a symlink; writing there, but not tightening or pruning it"
fi

if [ "$LOG_DIR_OWNED" = "1" ]; then
    # mkdir -m only sets the mode on creation, so a directory left behind
    # world-writable by something else (or simply pre-existing from an
    # older run) would never get tightened. Do it unconditionally instead —
    # but only for a directory this hook owns (see the block comment above).
    chmod 700 "$LOG_DIR" 2>/dev/null || true

    # Prune this hook's own old logs so the directory doesn't grow unbounded.
    # GNU find's `-mtime +3` matches files whose age exceeds 3 whole days,
    # i.e. it starts deleting at the 4-day mark, not the 3-day mark. Scoped
    # to this hook's own `*.log` files so it never removes anything else
    # that happens to be in the directory. Never touches anything younger
    # than that — a live run's log, passing or failing, must survive until
    # someone reads it. Only for an owned directory — see above.
    find "$LOG_DIR" -maxdepth 1 -type f -name '*.log' -mtime +3 -delete 2>/dev/null || true
fi

# A log written to the not-owned last-resort directory gets a prefix so it's
# attributable as this hook's even though it's sitting in a shared, unswept
# location. The normal (owned) case keeps the existing naming exactly.
LOG_FILE_PREFIX=""
[ "$LOG_DIR_OWNED" = "0" ] && LOG_FILE_PREFIX="lifeos-prepush-"

sanitize_branch_slug() {
    # Replace everything outside [A-Za-z0-9._-] (slashes included) with "_",
    # so a branch like "feat/x" or a hostile "../../etc/passwd" collapses to
    # a single safe filename component that can't escape LOG_DIR. Cap the
    # length so a very long branch name can't produce an unwieldy path.
    local slug
    slug=$(printf '%s' "$1" | tr -c 'A-Za-z0-9._-' '_')
    slug="${slug:0:80}"
    [ -z "$slug" ] && slug="unknown"
    printf '%s' "$slug"
}

if [ -n "$PUSH_LOCAL_REF" ] && [[ "$PUSH_LOCAL_REF" == refs/heads/* ]]; then
    BRANCH_RAW="${PUSH_LOCAL_REF#refs/heads/}"
else
    # No branch ref on stdin (e.g. a tag push, or nothing read at all) —
    # fall back to the checked-out branch, then a literal placeholder.
    BRANCH_RAW=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "unknown")
    [ "$BRANCH_RAW" = "HEAD" ] && BRANCH_RAW="detached"
fi
BRANCH_SLUG=$(sanitize_branch_slug "$BRANCH_RAW")

LOG="$LOG_DIR/${LOG_FILE_PREFIX}${BRANCH_SLUG}-$$-unit.log"
BROWSER_LOG="$LOG_DIR/${LOG_FILE_PREFIX}${BRANCH_SLUG}-$$-browser.log"

# Test overrides: stand in for the stdin ref lines so the decision below can be
# exercised without a real push (mirrors test.sh's LIFEOS_TEST_CHANGED_FILES).
if [ -n "${LIFEOS_PREPUSH_CHANGED_FILES+x}" ]; then
    CHANGED_FILES=$(printf '%s\n' "$LIFEOS_PREPUSH_CHANGED_FILES" | grep -v '^$' || true)
    HAVE_CONTENT="${LIFEOS_PREPUSH_HAVE_CONTENT:-1}"
fi

# Emit the decision and stop, without running anything.
plan_only_exit() {
    if [ -n "${LIFEOS_PREPUSH_PLAN_ONLY:-}" ]; then
        echo "prepush-plan: $1"
        echo "prepush-log: $LOG"
        echo "prepush-browser-log: $BROWSER_LOG"
        exit 0
    fi
}

# Is this push docs-only? Delegate to test.sh's decide_plan rather than keeping
# a second copy of the classification here. The two had already drifted: this
# hook's own regex matched `\.txt$`, so a requirements.txt / constraints.txt
# bump counted as "docs" and skipped the entire suite, while decide_plan
# deliberately excludes dependency manifests ("a dep bump must still run tests
# rather than skipping"). One implementation, covered by tests/test_test_sh_auto.py
# and tests/test_prepush_gate.py.
docs_only() {
    [ -n "$CHANGED_FILES" ] || return 1
    [ -f "$PROJECT_ROOT/scripts/test.sh" ] || return 1
    local plan
    plan=$(LIFEOS_TEST_PLAN_ONLY=1 LIFEOS_TEST_CHANGED_FILES="$CHANGED_FILES" \
        bash "$PROJECT_ROOT/scripts/test.sh" auto 2>/dev/null \
        | sed -n 's/^auto-plan: //p')
    [ "$plan" = "skip" ]
}

# Deletion-only push: no commits are being sent, so there is nothing to gate.
if [ "$HAVE_CONTENT" = "0" ]; then
    plan_only_exit "skip-deletion"
    echo "Pre-push: ref deletion only, nothing to test"
    exit 0
fi

if docs_only; then
    plan_only_exit "skip-docs"
    echo "Pre-push: docs-only push, skipping tests"
    exit 0
fi

plan_only_exit "run"

# Activate virtual environment
if [ -f "$HOME/.venvs/lifeos/bin/activate" ]; then
    source "$HOME/.venvs/lifeos/bin/activate"
fi

fail() {
    # $LOG may not exist (or be empty) if the failure happened before pytest
    # produced any output — e.g. the log directory turned out unusable mid-run.
    # Report that honestly instead of a blank "FAILED ()".
    if [ -s "$LOG" ] 2>/dev/null; then
        echo "FAILED ($(tail -1 "$LOG"))"
    elif [ -e "$LOG" ]; then
        echo "FAILED (empty log — command likely failed before producing output)"
    else
        echo "FAILED (no log was written to $LOG)"
    fi
    [ -e "$LOG" ] && echo "  Full output: $LOG"
    exit 1
}

echo "Log: $LOG"
echo -n "Running unit tests... "

# #682: this scope (`-m "unit and not slow"`) and scripts/test.sh's unit
# scope (the negative filter over browser/requires_server/integration/slow)
# are meant to agree, and after the #682 marker triage they collect the
# identical set (verified via --collect-only on both filters). Getting there
# required removing a conftest.py auto-marker that used to tag any test whose
# *name* contained "real_" or "integration" with `integration` on top of
# whatever marker it already carried — see tests/conftest.py's
# pytest_collection_modifyitems for the full story.
#
# Parallelize across all cores via pytest-xdist (-n auto). --ff runs
# previously-failed tests first, so a repeat failure surfaces in seconds
# without narrowing what actually runs.
#
# Deliberately no last-failed-only flag. Restricting the run to previously
# failed tests whenever a lastfailed cache existed collapsed the gate: fail
# once, fix it, and the next push ran a handful of tests out of ~2400 and
# passed — at exactly the moment the code had just changed. --ff keeps the
# fast-feedback ordering; it just doesn't deselect anything.
python -m pytest -m "unit and not slow" tests/ -q --tb=line --no-header \
    -n auto --ff > "$LOG" 2>&1 || fail
echo "passed ($(tail -1 "$LOG"))"

# Browser tests that need no running server. Server-dependent ones carry
# `requires_server`; including those would tie every push to the health of a
# shared lifeos-api that other agents bounce constantly. The rest serve web/
# themselves and stub every /api/ call, and are the only gate that catches a
# regression in the chat SPA's JS before it reaches main.
#
# Deliberately a second pytest process, not another marker in the run above:
# pytest-playwright's sync API leaves its own event loop current, so any async
# test that lands after a browser test in the same process fails with
# `RuntimeError: Runner.run() cannot be called from a running event loop`.
# Under `-n auto` that ordering is nondeterministic.
#
# -p no:cacheprovider keeps this run out of .pytest_cache so it can't disturb
# the unit run's --ff ordering data.
if python -c "import playwright" 2>/dev/null; then
    # Its own log, so a browser failure doesn't clobber the unit-run output
    # someone may still need to read.
    LOG="$BROWSER_LOG"
    echo "Log: $LOG"
    echo -n "Running server-free browser tests... "
    python -m pytest -m "browser and not requires_server" tests/ -q --tb=line \
        --no-header -p no:cacheprovider > "$LOG" 2>&1 || fail
    echo "passed ($(tail -1 "$LOG"))"
else
    # Say so rather than silently degrading — on a machine without Playwright
    # this gate is simply absent, and that should be visible.
    echo "Skipping browser tests (playwright not installed)"
fi

exit 0
