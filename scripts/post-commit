#!/bin/bash
#
# LifeOS Post-commit Hook
#
# Normalizes commit timestamps to 12:00 UTC (privacy: hides work schedule).
# Conditionally restarts the server in the background when api/ or config/
# files are in the commit.
#
# Installation:
#   cp scripts/post-commit .git/hooks/post-commit
#   chmod +x .git/hooks/post-commit
#

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# If we're in .git/hooks, go up to project root
if [[ "$SCRIPT_DIR" == *".git/hooks"* ]]; then
    PROJECT_DIR="$(cd "$SCRIPT_DIR/../.." && pwd)"
else
    PROJECT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
fi

cd "$PROJECT_DIR"

# Normalize commit timestamps to 12:00 UTC (privacy: hides work schedule)
# Guard prevents recursion when the amend triggers this hook again
if [ -z "$_LIFEOS_SKIP_DATE_NORMALIZE" ]; then
    AUTHOR_DATE=$(git log -1 --format='%aI')
    COMMIT_DATE=$(git log -1 --format='%cI')
    NORM_DATE="$(date -u -d "$(git log -1 --format='%ad' --date=short) 12:00" '+%Y-%m-%dT12:00:00+00:00')"

    if [ "$AUTHOR_DATE" != "$NORM_DATE" ] || [ "$COMMIT_DATE" != "$NORM_DATE" ]; then
        _LIFEOS_SKIP_DATE_NORMALIZE=1 \
        GIT_AUTHOR_DATE="$NORM_DATE" GIT_COMMITTER_DATE="$NORM_DATE" \
            git commit --amend --no-edit --no-verify --date="$NORM_DATE" >/dev/null 2>&1
    fi
fi

# Only restart server if api/ or config/ files were changed
CHANGED=$(git diff-tree --no-commit-id --name-only -r HEAD -- api/ config/)

if [ -n "$CHANGED" ]; then
    if [ -x "./scripts/server.sh" ]; then
        nohup ./scripts/server.sh restart > /tmp/lifeos-server-restart.log 2>&1 &
        echo "Server restart triggered (log: /tmp/lifeos-server-restart.log)"
    fi
else
    echo "No server restart needed"
fi
