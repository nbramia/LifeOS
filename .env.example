# LifeOS Environment Variables
# Copy this file to .env and fill in the values

# =============================================================================
# LLM BACKEND
# =============================================================================

# Which LLM backend to use for orchestration and synthesis
# "anthropic" (default) — uses Claude API (requires ANTHROPIC_API_KEY)
# "local" — uses llama-server at LIFEOS_LOCAL_LLM_URL
# LIFEOS_LLM_BACKEND=anthropic

# Anthropic API key (required for default backend)
# ANTHROPIC_API_KEY=sk-ant-...

# Anthropic model for orchestration
# Default: claude-haiku-4-5 (alias for claude-haiku-4-5-20251001)
# Override to pin a specific version or use a different model
# LIFEOS_ANTHROPIC_MODEL=claude-haiku-4-5

# Local LLM server URL (only used when LIFEOS_LLM_BACKEND=local)
# LIFEOS_LOCAL_LLM_URL=http://localhost:8080
# LIFEOS_LOCAL_LLM_TIMEOUT=90

# Local LLM model (HuggingFace GGUF ID for llama-server)
# Also used by setup-systemd.sh for the systemd service
# Available models:
#   ggml-org/gpt-oss-120b-GGUF  — ~59 GB VRAM (MXFP4), highest quality
#   Qwen/Qwen3-32B-GGUF        — ~20 GB VRAM (Q4_K_M), good quality, leaves headroom for embeddings
# To switch models: change this value, then run: sudo ./scripts/setup-systemd.sh
# LIFEOS_LLM_MODEL=ggml-org/gpt-oss-120b-GGUF

# Auto-start local LLM on boot and restart on crash (default: false)
# When false, llama-server must be started manually: sudo systemctl start lifeos-llm
# Run sudo ./scripts/setup-systemd.sh after changing this value
# LIFEOS_LOCAL_LLM_AUTOSTART=false

# =============================================================================
# VAULT CONFIGURATION
# =============================================================================

LIFEOS_VAULT_PATH=/path/to/your/obsidian/vault
LIFEOS_CHROMA_PATH=./data/chromadb
LIFEOS_PORT=8000

# Parent directory containing LifeOS and other code projects (default: ~/Code)
# Used by Claude Code orchestrator for project directory resolution
# LIFEOS_CODE_DIR=~/Code

# =============================================================================
# USER IDENTITY
# =============================================================================

# Your name (first name only, used in prompts and fact extraction)
# Example: Sarah, John, Alex
LIFEOS_USER_NAME=

# Your person ID (set after first sync — the server will log the lookup command)
# curl "http://localhost:8000/api/crm/people?q=YourName" | jq '.people[0].id'
LIFEOS_MY_PERSON_ID=

# Your work email domain for categorizing contacts (e.g., yourcompany.com)
LIFEOS_WORK_DOMAIN=

# =============================================================================
# RELATIONSHIP CONFIGURATION
# =============================================================================

# Your partner's name (first name only, used in relationship insights)
# Example: Taylor, Alex, Jane
# Leave empty if not using relationship features
LIFEOS_PARTNER_NAME=

# Therapist names for meeting note classification (pipe-separated full names)
# Meetings containing these names route to therapy folder
# Example: Dr. Smith|Jane Doe
# Leave empty to disable therapy meeting detection
LIFEOS_THERAPIST_PATTERNS=

# Personal relationship patterns for Granola meeting routing (pipe-separated)
# First names or nicknames that indicate a personal/relationship meeting
# Example: Taylor|Tay|Partner
# Leave empty to disable personal relationship meeting detection
LIFEOS_PERSONAL_RELATIONSHIP_PATTERNS=

# =============================================================================
# VAULT STRUCTURE
# =============================================================================

# Path prefix for your current work folder in Obsidian (include trailing slash)
# This is where work meetings, notes, and colleague data are stored
# Example: Work/MyCompany/, Work/Acme/, Work/
LIFEOS_CURRENT_WORK_PATH=Work/

# Path prefix for archived personal items (include trailing slash)
# Previous jobs, old projects, etc.
# Example: Personal/zArchive/, Archive/, Personal/Old/
LIFEOS_PERSONAL_ARCHIVE_PATH=Personal/zArchive/

# Folder name for relationship content under Personal/ (no slashes)
# Example: Relationship, Partner, Family
LIFEOS_RELATIONSHIP_FOLDER=Relationship

# =============================================================================
# MODEL CONFIGURATION (optional)
# =============================================================================

# Embedding model for vector search
# Default: mixedbread-ai/mxbai-embed-large-v1 (1024-dim, ~335M params)
# Smaller alternative: all-MiniLM-L6-v2 (384-dim, ~22M params — good for 8GB RAM)
# LIFEOS_EMBEDDING_MODEL=mixedbread-ai/mxbai-embed-large-v1

# Ollama model for query routing
# Default: qwen2.5:7b-instruct (~4.5GB VRAM)
# Smaller alternatives: qwen2.5:3b-instruct (~2GB), qwen2.5:1.5b-instruct (~1GB)
# OLLAMA_MODEL=qwen2.5:7b-instruct

# Cross-encoder reranker for search result reranking
# Default: cross-encoder/ms-marco-MiniLM-L6-v2 (~22M params)
# Set LIFEOS_RERANKER_ENABLED=false to disable on constrained hardware
# LIFEOS_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2
# LIFEOS_RERANKER_ENABLED=true

# =============================================================================
# GOOGLE OAUTH (optional)
# =============================================================================

# For Calendar/Gmail/Drive integration
# GOOGLE_CREDENTIALS_PERSONAL=./config/credentials-personal.json
# GOOGLE_CREDENTIALS_WORK=./config/credentials-work.json
# GOOGLE_TOKEN_PERSONAL=./config/token-personal.json
# GOOGLE_TOKEN_WORK=./config/token-work.json

# =============================================================================
# TIMEZONE (optional)
# =============================================================================

# IANA timezone for schedules, reminders, and AI context
# Default: America/New_York
# LIFEOS_TIMEZONE=America/New_York

# =============================================================================
# NOTIFICATIONS (optional)
# =============================================================================

# Email address for sync failure alerts
# LIFEOS_ALERT_EMAIL=your@email.com

# Telegram bot for notifications and chat interface
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# =============================================================================
# FINANCIAL DATA (optional)
# =============================================================================

# Monarch Money for account balances, transactions, budgets
# MONARCH_EMAIL=
# MONARCH_PASSWORD=

# =============================================================================
# BACKUP (optional)
# =============================================================================

# Directory for database backups (use fast storage like NVMe for large backups)
# LIFEOS_BACKUP_PATH=/path/to/nvme/lifeos-backups

# =============================================================================
# WORK INTEGRATIONS (optional - DISABLED by default)
# =============================================================================
#
# IMPORTANT: Work data synced here will be:
#   1. Stored locally in SQLite and ChromaDB
#   2. Sent to Claude API when you use synthesis features (chat, meeting prep)
#
# Only enable these if you understand and accept that work data (emails,
# calendar events, Slack messages) will be processed through Claude API.
#
# All work integrations are OFF by default for safety.
# =============================================================================

# Enable syncing work Gmail account (requires LIFEOS_WORK_DOMAIN to be set)
# LIFEOS_SYNC_WORK_GMAIL=true

# Enable syncing work Google Calendar (requires LIFEOS_WORK_DOMAIN to be set)
# LIFEOS_SYNC_WORK_CALENDAR=true

# Second work account (optional)
# LIFEOS_WORK_DOMAIN_2=othercompany.com
# LIFEOS_SYNC_WORK2_GMAIL=true
# LIFEOS_SYNC_WORK2_CALENDAR=true

# Enable syncing Slack workspace messages
# LIFEOS_SYNC_SLACK=true

# Slack OAuth credentials (required if LIFEOS_SYNC_SLACK=true)
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=
# SLACK_USER_TOKEN=xoxp-...
